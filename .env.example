# Visarto environment.
#
# Every one of these is optional. The site builds, runs and is reviewable with
# none of them set: the CMS returns nothing, the appointment form is visibly
# switched off, no analytics event is sent, and robots.txt refuses all crawling.
#
# Copy this file to .env.local for development. Never commit a filled copy.

# ---- Canonical origin -------------------------------------------------------
# The production hostname, with protocol and no trailing slash. Until this is
# set, robots.txt disallows everything, so a preview deployment cannot be
# crawled or compete with production in search.
NEXT_PUBLIC_SITE_URL=

# ---- Sanity -----------------------------------------------------------------
# Without a project id the site falls back to its authored baseline and the
# studio at /studio says it is not connected.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server only. Needed only for reading drafts. Never expose this to the browser.
SANITY_READ_TOKEN=

# ---- Appointments -----------------------------------------------------------
# Where an appointment or inquiry request is delivered: a webhook, a form
# service, or an internal endpoint. Server only.
#
# Until this is set, /api/appointments answers 503 and the request form is shown
# as switched off. Nothing is collected that cannot be delivered, and no visitor
# ever sees a confirmation for a request that went nowhere.
APPOINTMENT_ENDPOINT=

# If Visarto books through an external system, its URL. When set, the
# appointments page hands over to it instead of showing the request form. This
# can also be set per environment from appointmentSettings in the CMS.
NEXT_PUBLIC_BOOKING_URL=

# ---- Analytics --------------------------------------------------------------
# Until this is set, track() is a no-op and nothing is sent anywhere.
NEXT_PUBLIC_ANALYTICS_ID=
